{
  "name": "family-grocery-list",
  "version": "2.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios --no-bundler",
    "start:dev": "expo start --dev-client --port 8090",
    "ios:dev": "yarn ios && yarn start:dev",
    "web": "expo start --web",
    "clean": "rm -rf node_modules package-lock.json && yarn install",
    "clean:android": "cd android && ./gradlew clean -x app:externalNativeBuildCleanDebug -x app:externalNativeBuildCleanRelease && rm -rf build && rm -rf app/build && rm -rf app/.cxx && cd ..",
    "clean:ios": "cd ios && rm -rf Pods Podfile.lock build && pod install && cd ..",
    "build:android": "yarn build:android:apk",
    "build:android:apk": "cd android && ./gradlew assembleRelease && cd ..",
    "build:android:aab": "cd android && ./gradlew bundleRelease && cd ..",
    "lint": "eslint .",
    "lint:fix": "yarn lint -- --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --check ./src/**/*.{ts,tsx}",
    "format:fix": "prettier --write ./src/**/*.{ts,tsx}",
    "prepare": "husky",
    "commitlint-check": "commitlint --from HEAD~1 --to HEAD --verbose",
    "type-check": "tsc --noEmit",
    "postinstall": "node scripts/patch-expo-autolinking.js"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@hookform/resolvers": "^5.5.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "expo": "~55.0.28",
    "expo-auth-session": "~55.0.17",
    "expo-crypto": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.5",
    "expo-web-browser": "~55.0.18",
    "firebase": "^12.16.0",
    "lucide-react-native": "^1.27.0",
    "nativewind": "^4.2.6",
    "react": "19.2.0",
    "react-hook-form": "^7.83.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "yup": "^1.7.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/react": "~19.2.17",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-preset-expo": "~55.0.24",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true,
  "packageManager": "yarn@1.22.22"
}
