{
  "name": "family-grocery-list",
  "version": "2.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios --no-bundler",
    "start:dev": "expo start --dev-client --port 8090",
    "ios:dev": "yarn ios && yarn start:dev",
    "web": "expo start --web",
    "clean": "rm -rf node_modules package-lock.json && yarn install",
    "clean:android": "cd android && ./gradlew clean -x app:externalNativeBuildCleanDebug -x app:externalNativeBuildCleanRelease && rm -rf build && rm -rf app/build && rm -rf app/.cxx && cd ..",
    "clean:ios": "cd ios && rm -rf Pods Podfile.lock build && pod install && cd ..",
    "build:android": "yarn build:android:apk",
    "build:android:apk": "cd android && ./gradlew assembleRelease && cd ..",
    "build:android:aab": "cd android && ./gradlew bundleRelease && cd ..",
    "lint": "eslint .",
    "lint:fix": "yarn lint -- --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --check ./src/**/*.{ts,tsx}",
    "format:fix": "prettier --write ./src/**/*.{ts,tsx}",
    "prepare": "husky",
    "commitlint-check": "commitlint --from HEAD~1 --to HEAD --verbose",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@tanstack/react-query": "^5.104.3",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "expo": "^57.0.9",
    "expo-auth-session": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-dev-client": "~58.0.13",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.6",
    "expo-linear-gradient": "~58.0.3",
    "expo-notifications": "~58.1.4",
    "expo-splash-screen": "~58.0.9",
    "expo-status-bar": "~58.0.3",
    "expo-web-browser": "~58.0.6",
    "firebase": "^13.0.0",
    "lucide-react-native": "^1.58.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-hook-form": "^7.90.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "yup": "^1.7.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/react": "~19.2.17",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^10.12.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "packageManager": "yarn@1.22.22"
}
